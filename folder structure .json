{
  "project": {
    "name": "GVP-MAAA",
    "type": "full-stack college ERP/analytics platform",
    "stack": {
      "frontend": "React + Vite",
      "backend": "FastAPI + SQLAlchemy",
      "database": "PostgreSQL-style schema",
      "analytics": "ML/insights modules"
    },
    "repo": {
      "owner": "MOHITH-KVS",
      "name": "GVP-MAAA",
      "defaultBranch": "main",
      "currentBranch": "main"
    }
  },
  "run": {
    "frontend": {
      "workingDirectory": "gvp-maaa",
      "command": "npm run dev"
    },
    "backend": {
      "workingDirectory": "gvp-maaa/Backend",
      "command": "uvicorn main:app --reload",
      "apiDocs": "http://127.0.0.1:8000/docs"
    }
  },
